# Copy to .env and replace locally. Never commit the real connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/trip_expense_tracker
MONGODB_DB_NAME=trip_expense_tracker

# Hosting: set NODE_ENV=production to accept the host's incoming connections.
# PORT is supplied by the hosting provider. HOST can override the bind address.

# Firebase Google-only sign-in. Client values are public; Admin values stay server-side.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional Web Push: generate once with web-push.generateVAPIDKeys(). Keep private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://triproam.onrender.com
